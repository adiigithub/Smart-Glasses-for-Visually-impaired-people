NODE_ENV=development
PORT=5000

MONGO_URI=YOUR_MONGO_URL

JWT_SECRET=YOUR_SECRET_KEY
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=YOUR_EMAIL_ID
SMTP_PASSWORD=YOUR_PASS_KEY
FROM_EMAIL=ANOTHER_PERSON_EMAIL_ID
FROM_NAME=Smart Glass Monitor

# Smart Glass ESP32 Configuration
# This needs to be set to an actual User ID from the database after creating a user
ESP32_USER_ID=USER_DB_ID
